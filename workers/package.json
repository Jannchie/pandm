{
  "name": "pandm-workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "migrate": "wrangler d1 migrations apply pandm --remote",
    "deploy": "pnpm run migrate && pnpm -C ../web install && pnpm -C ../web build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^7.0.2",
    "vitest": "~4.1.10",
    "wrangler": "^4.115.0"
  }
}
